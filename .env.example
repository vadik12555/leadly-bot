# ==== Обязательное ====
# Токен бота от @BotFather (/mybots → бот → API Token). Никому не пересылай.
BOT_TOKEN=
# Твой числовой Telegram ID (узнать: @userinfobot). Через запятую, если админов несколько.
ADMIN_IDS=
# Контакт поддержки для /paysupport и /terms, например @your_username
SUPPORT_CONTACT=
# Кто оператор персональных данных (для /privacy), например: ИП Иванов Иван Иванович, ИНН 000000000000
OPERATOR_NAME=
# Твой Telegram-канал (без @). Кнопка в меню и бонус за подписку. Бота нужно добавить в канал администратором,
# иначе Telegram не даст проверить подписку.
CHANNEL_USERNAME=

# ==== Источники данных ====
# osm — OpenStreetMap (бесплатно, без ключа). Можно несколько: osm,2gis
# demo — вымышленные компании для проверки интерфейса (нельзя смешивать с реальными)
SEARCH_PROVIDERS=osm
# E-mail для User-Agent запросов к OpenStreetMap (просят их правила использования)
OSM_CONTACT=
# Ключ 2ГИС Places API (https://dev.2gis.com). Пусто — 2ГИС не используется.
TWOGIS_API_KEY=

# ==== ИИ ====
# none | anthropic | openai_compat
AI_PROVIDER=none
# для AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# для AI_PROVIDER=openai_compat (DeepSeek, OpenRouter, YandexGPT-совместимый эндпоинт и т.п.)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ==== Оплата ====
# Оплата тарифов в Telegram Stars. false — кнопки оплаты скрыты.
PAYMENTS_ENABLED=true

# ==== Технические ====
DB_PATH=data/leadly.db
LOG_FILE=data/leadly.log
LOG_LEVEL=INFO
# Прокси для api.telegram.org, если сервер не видит Telegram напрямую (http://user:pass@host:port)
# Если Telegram заблокирован: http://127.0.0.1:10809 или socks5://127.0.0.1:10808 (порт из приложения VPN)
TELEGRAM_PROXY=
